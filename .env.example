RETAINIQ_SECRET_KEY=replace-with-a-strong-random-secret

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=mysql
DB_NAME=retainiq
DB_PORT=3306

FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
# Railway deployment:
# Railway's MySQL service provides MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD and MYSQLDATABASE automatically. RetainIQ supports
# those variables directly, so DB_* variables do not need to be set there.
#
# For HTTPS deployment set:
# SESSION_COOKIE_SECURE=1
